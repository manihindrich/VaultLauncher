<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.manihindrich.VaultLauncher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Vault Launcher</name>
  <summary>Pick an Obsidian vault and open it</summary>

  <developer id="io.github.manihindrich">
    <name>Mani Hindrich</name>
  </developer>

  <description>
    <p>
      A small window that lists your Obsidian vaults and opens the one you pick,
      instead of whatever vault Obsidian opened last.
    </p>
    <ul>
      <li>Vaults are read from Obsidian's own configuration and kept in sync while the window is open</li>
      <li>Add folders by hand, give vaults your own labels, hide the ones you do not need</li>
      <li>Sort by last use, folder name or label</li>
      <li>Light, dark or system theme matching Obsidian's default look</li>
      <li>Optionally closes itself after opening a vault</li>
    </ul>
    <p>Vault Launcher is not affiliated with Obsidian.</p>
  </description>

  <launchable type="desktop-id">io.github.manihindrich.VaultLauncher.desktop</launchable>
  <provides>
    <binary>vault-launcher</binary>
  </provides>

  <url type="homepage">https://github.com/manihindrich/VaultLauncher</url>
  <url type="bugtracker">https://github.com/manihindrich/VaultLauncher/issues</url>
  <url type="vcs-browser">https://github.com/manihindrich/VaultLauncher</url>

  <screenshots>
    <screenshot type="default">
      <caption>Pick a vault and open it in Obsidian</caption>
      <image>https://raw.githubusercontent.com/manihindrich/VaultLauncher/v0.1.0/data/screenshots/main.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings with a short help</caption>
      <image>https://raw.githubusercontent.com/manihindrich/VaultLauncher/v0.1.0/data/screenshots/settings.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#e4dafd</color>
    <color type="primary" scheme_preference="dark">#3b2a6b</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-10-11">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
